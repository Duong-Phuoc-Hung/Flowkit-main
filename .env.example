# FlowKit — Environment Configuration
# Copy file này thành .env và điền các giá trị thực

# ─── Google Flow API (BẮT BUỘC) ────────────────────────────
# Lấy từ: chrome://extensions → Flow Kit → ID token
GOOGLE_API_KEY=

# ─── API Server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8100

# ─── WebSocket (Chrome Extension) ───────────────────────────
WS_HOST=127.0.0.1
WS_PORT=9222

# ─── Worker Tuning ──────────────────────────────────────────
POLL_INTERVAL=5
MAX_RETRIES=5
API_COOLDOWN=10
MAX_CONCURRENT_REQUESTS=5
STALE_PROCESSING_TIMEOUT=600
VIDEO_POLL_INTERVAL=10
VIDEO_POLL_TIMEOUT=420

# ─── TTS (OmniVoice) ─────────────────────────────────────────
TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE=cpu
TTS_SAMPLE_RATE=24000

# ─── AI Review (Claude Vision) ───────────────────────────────
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-haiku-4-5-20251001
REVIEW_FPS_LIGHT=4
REVIEW_FPS_DEEP=8
REVIEW_MAX_FRAMES=64

# ─── Suno Music Generation ───────────────────────────────────
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V4

# ─── reCAPTCHA ───────────────────────────────────────────────
RECAPTCHA_SITE_KEY=6LdsFiUsAAAAAIjVDZcuLhaHiDn5nnHVXVRQGeMV
